<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: nothing of the app goes into a cloud backup or a move to a new phone
     (the signed-in session lives in the app's data). See AndroidManifest.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
