# Public values only. The real ones live in Netlify env vars and the Claude Code environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: Cloudflare Turnstile site key (public). Set it together with CAPTCHA in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=
# Optional: Sentry project address (DSN, public). Error reports are sent only when it is set (T19).
VITE_SENTRY_DSN=
