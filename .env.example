# Public values only. The real ones live in Netlify env vars and the Claude Code environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: Cloudflare Turnstile site key (public). Set it together with CAPTCHA in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=
# Optional: Sentry project address (DSN, public). Error reports are sent only when it is set (T19).
VITE_SENTRY_DSN=

# Map tiles (T28b, public): a {z}/{x}/{y} URL from the map provider, e.g. MapTiler with its public key.
# Unset = OpenStreetMap's own tile server (fine for testing, not for launch traffic).
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Optional, Netlify build only (never VITE_, never in the app): uploads the source maps to Sentry
# so error reports show the exact line; without them the maps are simply not published (SEC-03).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
